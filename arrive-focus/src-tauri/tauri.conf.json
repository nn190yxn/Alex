{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "抵达 Focus",
  "version": "0.1.8",
  "identifier": "com.arrive.focus",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "抵达 Focus",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "visible": false
      },
      {
        "label": "widget",
        "title": "抵达 Focus 小组件",
        "url": "widget.html",
        "width": 360,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nn190yxn/Alex/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBQjEyNkU3QkRGMUQ0MEQKUldRTjFQRzk1eWF4YW1PRzdLaWlaZjNvZlUvcklGbjlnSTdoc2phSkJFWFdKaUlrNk1XSEtUUncK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "抵达 Focus"
      }
    }
  }
}
