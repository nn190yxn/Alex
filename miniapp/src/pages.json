{
  "pages": [
    {
      "path": "pages/home/index",
      "style": { "navigationBarTitleText": "首页" }
    },
    {
      "path": "pages/ai/index",
      "style": {
        "navigationBarTitleText": "AI",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/tools/index",
      "style": { "navigationBarTitleText": "工具箱" }
    },
    {
      "path": "pages/user/index",
      "style": { "navigationBarTitleText": "我的" }
    }
  ],
  "subPackages": [
    {
      "root": "pages-sub",
      "pages": [
        {
          "path": "login/index",
          "style": { "navigationBarTitleText": "登录" }
        },
        {
          "path": "register/index",
          "style": { "navigationBarTitleText": "注册" }
        },
        {
          "path": "tool-run/index",
          "style": { "navigationBarTitleText": "生成" }
        },
        {
          "path": "history/index",
          "style": {
            "navigationBarTitleText": "历史",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "history-detail/index",
          "style": { "navigationBarTitleText": "详情" }
        },
        {
          "path": "membership/index",
          "style": { "navigationBarTitleText": "会员中心" }
        },
        {
          "path": "referral/index",
          "style": {
            "navigationBarTitleText": "邀请返利",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "favorites/index",
          "style": {
            "navigationBarTitleText": "收藏",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "privacy/index",
          "style": { "navigationBarTitleText": "隐私政策" }
        },
        {
          "path": "agreement/index",
          "style": { "navigationBarTitleText": "用户协议" }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/home/index": {
      "network": "all",
      "packages": ["pages-sub"]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "我赢AI",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F8F8F8"
  },
  "tabBar": {
    "color": "#666",
    "selectedColor": "#0e7490",
    "backgroundColor": "#fff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/ai/index",
        "text": "AI"
      },
      {
        "pagePath": "pages/tools/index",
        "text": "工具"
      },
      {
        "pagePath": "pages/user/index",
        "text": "我的"
      }
    ]
  }
}
