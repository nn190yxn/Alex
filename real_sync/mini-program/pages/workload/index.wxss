.container{min-height:100vh;background:#f5f3f0;padding:16px 16px 96px;box-sizing:border-box}.hero{background:linear-gradient(135deg,#ff6b35,#ff9a5f);border-radius:22px;padding:20px;color:#fff;margin-bottom:14px;box-shadow:0 8px 20px rgba(255,107,53,.2)}.hero-title{font-size:22px;font-weight:800;margin-bottom:6px}.hero-sub{font-size:13px;opacity:.92;line-height:1.6}.user-pill{display:inline-flex;margin-top:10px;background:rgba(255,255,255,.2);border-radius:999px;padding:4px 10px;font-size:12px;font-weight:700}.card{background:#fff;border-radius:18px;padding:16px;margin-bottom:14px;border:1px solid rgba(0,0,0,.06);box-shadow:0 4px 14px rgba(0,0,0,.04)}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.field{margin-bottom:12px}.label{display:block;font-size:12px;color:#6b625c;font-weight:700;margin-bottom:6px}.picker-value,.input,.textarea{background:#fafafa;border:1px solid rgba(0,0,0,.08);border-radius:12px;padding:11px 12px;font-size:15px;box-sizing:border-box}.input{width:100%}.textarea{width:100%;height:84px}.status{font-size:13px;color:#6b625c;line-height:1.6}.status.ok{color:#087443}.status.err{color:#b42318}.metric{display:grid;grid-template-columns:1fr 112px;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid rgba(0,0,0,.06)}.metric:last-child{border-bottom:none}.metric-name{font-size:14px;font-weight:750;color:#1f1a17}.metric-meta{font-size:11px;color:#6b625c;margin-top:3px}.metric-input{background:#fff7ed;border:1px solid rgba(255,107,53,.2);border-radius:12px;padding:10px;text-align:center;color:#ff6b35;font-weight:800}.empty{text-align:center;color:#6b625c;padding:28px 0}.actions{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid rgba(0,0,0,.08);padding:10px 16px calc(10px + env(safe-area-inset-bottom));display:flex;gap:10px}.btn{flex:1;border-radius:14px;padding:12px;font-size:15px;font-weight:800}.btn.secondary{background:#f1eee9;color:#1f1a17}.btn.primary{background:#ff6b35;color:#fff}
